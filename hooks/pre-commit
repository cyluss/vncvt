#!/usr/bin/env python
"""Pre-commit hook: run the unit test suite before every commit.

To enable, run once from the repo root:
    git config core.hooksPath hooks

Requires uv on PATH (https://docs.astral.sh/uv/).
On Windows, delegates to WSL 2 automatically. The venv is placed on
the native Linux filesystem (~/.venvs/vncvt) to avoid slow /mnt/c
I/O — first run installs packages (~5s), subsequent runs are instant.
"""

import os
import platform
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
TESTS = REPO / "tests" / "unit"

# Keep the venv on the Linux filesystem for fast I/O.
_WSL_VENV = "$HOME/.venvs/vncvt"


def main() -> int:
    print("Running unit tests…", flush=True)

    if platform.system() == "Windows":
        # Convert Windows path to WSL /mnt/... path
        drive = REPO.drive.rstrip(":")  # "C:" → "C"
        posix = f"/mnt/{drive.lower()}{REPO.as_posix()[2:]}"
        result = subprocess.run(
            ["wsl", "bash", "-lc",
             f"cd '{posix}' && "
             f"UV_PROJECT_ENVIRONMENT={_WSL_VENV} "
             f"uv run pytest tests/unit/ -q --tb=short"],
        )
    else:
        result = subprocess.run(
            ["uv", "run", "pytest", str(TESTS), "-q", "--tb=short"],
            cwd=str(REPO),
        )

    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
